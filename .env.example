# Copy to .env for manual configuration; setup-local.php can generate local values.
APP_NAME=Stockroom
APP_ENV=development
APP_KEY=
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lab6_stockroom
DB_CHARSET=utf8mb4
DB_PREFIX=
# For Aiven: set true and provide the downloaded CA certificate path.
DB_SSL_REQUIRED=false
DB_SSL_CA=
# Generate distinct random values with php lava jwt:generate.
JWT_SECRET=
REFRESH_TOKEN_KEY=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost
MIGRATION_ENABLED=false
